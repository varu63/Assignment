```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
uploads/
tmp/
temp/

# TypeScript
*.tsbuildinfo

# Coverage
coverage/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Docker
.dockerignore

# Optional local database files
*.sqlite
*.db

# Generated files
generated/
```
